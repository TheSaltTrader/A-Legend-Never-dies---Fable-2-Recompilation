+void D3D12CommandProcessor::MarkNewerResolve(uint32_t address, uint32_t length) {
+  if (!RbOrderEnabled()) return;
+  const uint64_t end = uint64_t(address) + length;
+  for (PendingResolveReadback& p : pending_resolve_readbacks_) {
+    const uint64_t ps = p.address, pe = uint64_t(p.address) + p.length;
+    const uint64_t os = std::max<uint64_t>(ps, address), oe = std::min<uint64_t>(pe, end);
+    if (os >= oe) continue;
+    g_rb_order_skips.fetch_add(1, std::memory_order_relaxed);
+    if (p.skip_count < 4) {
+      p.skip_start[p.skip_count] = uint32_t(os);
+      p.skip_end[p.skip_count] = uint32_t(oe);
+      ++p.skip_count;
+    } else {
+      p.skip_start[3] = std::min<uint32_t>(p.skip_start[3], uint32_t(os));
+      p.skip_end[3] = std::max<uint32_t>(p.skip_end[3], uint32_t(oe));
+      g_rb_order_widened.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+}
+
+void D3D12CommandProcessor::LandPendingReadback(const PendingResolveReadback& p, const uint8_t* source) {
+  if (!source) return;
+  if (!p.skip_count) {
+    CopyToGuestMemory(p.address, source, p.length);
+    return;
+  }
+  g_rb_order_avoided.fetch_add(1, std::memory_order_relaxed);
+  // Copy the pieces of [address, address+length) outside every skip range, in address order.
+  uint32_t cursor = p.address;
+  const uint32_t end = p.address + p.length;
+  while (cursor < end) {
+    uint32_t next_skip = end, skip_to = end;
+    for (uint32_t i = 0; i < p.skip_count; ++i) {
+      if (p.skip_end[i] <= cursor) continue;
+      const uint32_t st = std::max(p.skip_start[i], cursor);
+      if (st < next_skip) { next_skip = st; skip_to = p.skip_end[i]; }
+      else if (st == next_skip) skip_to = std::max(skip_to, p.skip_end[i]);
+    }
+    if (next_skip > cursor) CopyToGuestMemory(cursor, source + (cursor - p.address), next_skip - cursor);
+    cursor = std::max(skip_to, next_skip);
+    if (next_skip == end) break;
+  }
+}
