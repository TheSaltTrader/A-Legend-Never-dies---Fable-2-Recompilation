--- /dev/null
+++ b/include/rex/kernel/xboxkrnl/io.h
@@ -0,0 +1,25 @@
+// Observing the guest's file opens.
+//
+// A title announces what it is doing through the files it opens - a chapter's
+// story data, a region's audio bank - and a port that wants to act on "a stage
+// is loading" can read that event here instead of reverse-engineering the
+// loader. The NG2 port did this with a midasm hook on its own file wrapper;
+// this is the same event, one level down, available to every title.
+
+#pragma once
+
+#include <functional>
+#include <string>
+
+namespace rex::kernel::xboxkrnl {
+
+// Called for every NtCreateFile / NtOpenFile the guest makes, with the
+// translated path (for example "game:\data\audio\atmos_bowerstone_market.bnk")
+// and whether the open succeeded. It runs on the guest thread that made the
+// open, after the kernel has finished with it: keep it cheap, and do not call
+// back into the kernel from it. One observer at a time; an empty function
+// clears it.
+using FileOpenObserver = std::function<void(const std::string& path, bool opened)>;
+void SetFileOpenObserver(FileOpenObserver observer);
+
+}  // namespace rex::kernel::xboxkrnl
