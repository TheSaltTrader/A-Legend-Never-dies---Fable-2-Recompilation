 #include <rex/kernel/xboxkrnl/private.h>
 #include <rex/logging.h>
 #include <rex/memory.h>
@@ -100,6 +103,29 @@ static bool IsValidPath(const std::string_view s, bool is_pattern) {
   return true;
 }
 
+// The file-open observer (io.h). Held under its own lock and COPIED out before
+// being called, so an app may replace it from any thread while opens are in
+// flight, and so the lock is never held across the callback.
+namespace {
+std::mutex g_file_open_observer_mutex;
+FileOpenObserver g_file_open_observer;
+
+void NotifyFileOpenObserver(const std::string& path, bool opened) {
+  FileOpenObserver observer;
+  {
+    std::lock_guard<std::mutex> lock(g_file_open_observer_mutex);
+    observer = g_file_open_observer;
+  }
+  if (observer)
+    observer(path, opened);
+}
+}  // namespace
+
+void SetFileOpenObserver(FileOpenObserver observer) {
+  std::lock_guard<std::mutex> lock(g_file_open_observer_mutex);
+  g_file_open_observer = std::move(observer);
+}
